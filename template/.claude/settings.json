{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(make *)",
      "Bash(python3 *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Edit(**/manuscript/shared/figures/generated/**)",
      "Write(**/manuscript/shared/figures/generated/**)",
      "Edit(**/refs/local/locations.toml)",
      "Write(**/refs/local/locations.toml)",
      "Edit(**/manuscript/shared/style/journal.cls)",
      "Write(**/manuscript/shared/style/journal.cls)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/refresh-session-context.sh",
            "once": true
          }
        ]
      }
    ]
  }
}
