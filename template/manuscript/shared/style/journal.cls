% このクラスはハーネスのスターター用である。
% 通常はこの shared class を置き換えず、投稿先公式クラス（elsarticle 等）は
% submission/<venue>/ に置く。shared class を置き換えるのは明示タスク時のみ。
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{journal}[2026/04/13 paper harness starter class]
\LoadClass[11pt,a4paper]{article}

\RequirePackage[margin=25mm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage[hidelinks]{hyperref}
