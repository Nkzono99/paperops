{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperops.local/schemas/research-gate.schema.json", "title": "PaperOps Research scientific gate", "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "claim_id", "gate_decision", "required_checks", "blocking_feedback_refs", "analysis_request_refs", "central_assumptions", "claim_stress_tests", "external_validation_gates", "path_criterion", "evidence_design", "approved_writing_scope", "not_covered", "block_reason", "history", "human_approval"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "scientific_gate"}, "id": {"type": "string", "pattern": "^GATE-[0-9]{4,}$"}, "revision": {"type": "integer"}, "status": {"enum": ["draft", "active", "superseded"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "extensions": {"type": "object", "additionalProperties": true}, "metadata": {"$ref": "#/$defs/metadata"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}, "gate_decision": {"enum": ["draft", "ready_to_write", "analysis_needed", "assumption_blocked", "supplement_only", "deferred"]}, "required_checks": {"$ref": "#/$defs/strings"}, "blocking_feedback_refs": {"$ref": "#/$defs/strings"}, "analysis_request_refs": {"$ref": "#/$defs/strings"}, "central_assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}}, "claim_stress_tests": {"type": "array", "items": {"$ref": "#/$defs/stress"}}, "external_validation_gates": {"type": "array", "items": {"$ref": "#/$defs/externalGate"}},
    "path_criterion": {"enum": ["unchecked", "checked", "not_applicable"]}, "evidence_design": {"enum": ["unchecked", "checked", "not_applicable"]}, "approved_writing_scope": {"type": "string"}, "not_covered": {"$ref": "#/$defs/strings"}, "block_reason": {"type": "string"}, "history": {"type": "array", "items": {"$ref": "#/$defs/history"}}, "human_approval": {"enum": ["needed", "approved", "rejected"]}
  }, "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_hash"], "properties": {"target_id": {"type": "string"}, "relation": {"type": "string"}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]*$"}, "decision": {"enum": ["approved", "rejected", "revoked", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false},
    "history": {"type": "object", "required": ["event_id", "decision", "note"], "properties": {"event_id": {"type": "string", "pattern": "^HIS-[0-9]{4,}$"}, "decision": {"enum": ["draft", "ready_to_write", "analysis_needed", "assumption_blocked", "supplement_only", "deferred"]}, "note": {"type": "string"}}, "additionalProperties": false},
    "assumption": {"type": "object", "required": ["id", "guarded_claim_refs", "artifact_role", "solved", "bound_role", "manuscript_block_refs", "status", "required_follow_up"], "properties": {"id": {"type": "string", "pattern": "^ASM-[0-9]{4,}$"}, "guarded_claim_refs": {"$ref": "#/$defs/strings"}, "artifact_role": {"enum": ["measured_model", "validated_solver_output", "proxy", "sensitivity", "authoring_guard"]}, "solved": {"type": "boolean"}, "bound_role": {"enum": ["none", "upper", "lower"]}, "manuscript_block_refs": {"$ref": "#/$defs/strings"}, "status": {"enum": ["supported", "proxy", "sensitivity", "unresolved"]}, "required_follow_up": {"type": "string"}}, "additionalProperties": false},
    "stress": {"type": "object", "required": ["id", "claim_component", "stress_input", "stress_outcome", "strongest_allowed_wording", "must_not_claim", "nearest_caveat", "source_artifact_ids"], "properties": {"id": {"type": "string", "pattern": "^STRESS-[0-9]{4,}$"}, "claim_component": {"type": "string"}, "stress_input": {"type": "string"}, "stress_outcome": {"type": "string"}, "strongest_allowed_wording": {"type": "string"}, "must_not_claim": {"type": "string"}, "nearest_caveat": {"type": "string"}, "source_artifact_ids": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "externalGate": {"type": "object", "required": ["id", "blocking_claim_ref", "required_external_evidence", "allowed_wording", "must_not_claim", "route_ref"], "properties": {"id": {"type": "string", "pattern": "^EXT-[0-9]{4,}$"}, "blocking_claim_ref": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"}, "required_external_evidence": {"type": "string"}, "allowed_wording": {"type": "string"}, "must_not_claim": {"type": "string"}, "route_ref": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
