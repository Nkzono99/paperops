{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperops.local/schemas/research-source.schema.json", "title": "PaperOps Research source", "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "source_kind", "citation_keys", "verification_state", "promotion_decision", "promotion_required_when", "promotion_reason", "claim_boundary", "parameter_choice", "reviewer_objection", "method_precedent", "claim_refs", "manuscript_block_refs", "related_work_role", "related_work_cluster", "paper_roles", "public_provenance_refs"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "source"}, "id": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}, "revision": {"type": "integer"}, "status": {"enum": ["draft", "verified", "promoted", "rejected", "superseded"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "extensions": {"type": "object", "additionalProperties": true}, "metadata": {"$ref": "#/$defs/metadata"},
    "source_kind": {"enum": ["literature", "web", "github", "video", "rss", "social", "discussion", "dataset", "software"]}, "citation_keys": {"$ref": "#/$defs/strings"}, "verification_state": {"enum": ["unverified", "partially_verified", "verified", "rejected"]}, "promotion_decision": {"enum": ["hold", "source_card", "reject"]}, "promotion_required_when": {"type": "array", "items": {"enum": ["claim_boundary", "parameter_choice", "reviewer_objection", "method_precedent"]}},
    "promotion_reason": {"type": "string"}, "claim_boundary": {"type": "string"}, "parameter_choice": {"type": "string"}, "reviewer_objection": {"type": "string"}, "method_precedent": {"type": "string"}, "claim_refs": {"$ref": "#/$defs/strings"}, "manuscript_block_refs": {"$ref": "#/$defs/strings"}, "related_work_role": {"type": "string"}, "related_work_cluster": {"type": "string"}, "paper_roles": {"type": "object", "required": ["supports", "contrasts", "motivates", "challenges"], "properties": {"supports": {"type": "string"}, "contrasts": {"type": "string"}, "motivates": {"type": "string"}, "challenges": {"type": "string"}}, "additionalProperties": false}, "public_provenance_refs": {"$ref": "#/$defs/strings"}
  }, "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_hash"], "properties": {"target_id": {"type": "string"}, "relation": {"type": "string"}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"enum": ["scientific_scope", "editorial_choice", "submission", "authorship", "license", "external_share", "reviewer_response", "scope_expansion"]}, "decision": {"enum": ["approved", "rejected", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false}
  }
}
