{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperops.local/schemas/research-figure.schema.json", "title": "PaperOps Research figure", "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "figure_ref", "reader_task", "takeaway", "claim_or_decision", "encoding", "scale_denominator", "uncertainty", "caption_scope", "accessibility", "acceptance_criteria", "why_figure_not_text_table", "panel_story", "primary_comparison", "annotation_plan", "caption_plan", "render_size", "runops_handoff_id", "missing_action", "result_refs", "claim_refs", "manuscript_block_refs", "visual_obligation_refs", "manuscript_role", "design_review", "audit_checks", "route"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "figure"}, "id": {"type": "string", "pattern": "^FIG-[0-9]{4,}$"}, "revision": {"type": "integer"}, "status": {"enum": ["draft", "planned", "designed", "validated", "accepted", "rejected", "superseded"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "extensions": {"type": "object", "additionalProperties": true}, "metadata": {"$ref": "#/$defs/metadata"},
    "figure_ref": {"type": "string", "pattern": "^figure:[A-Za-z0-9_-]+$"}, "reader_task": {"type": "string", "minLength": 1}, "takeaway": {"type": "string", "minLength": 1}, "claim_or_decision": {"type": "string", "minLength": 1}, "encoding": {"type": "string", "minLength": 1}, "scale_denominator": {"type": "string", "minLength": 1}, "uncertainty": {"type": "string"}, "caption_scope": {"type": "string", "minLength": 1}, "accessibility": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"$ref": "#/$defs/strings"}, "why_figure_not_text_table": {"type": "string", "minLength": 1}, "panel_story": {"$ref": "#/$defs/strings"}, "primary_comparison": {"type": "string", "minLength": 1}, "annotation_plan": {"type": "string"}, "caption_plan": {"type": "string", "minLength": 1}, "render_size": {"enum": ["single_column", "double_column", "full_page"]}, "runops_handoff_id": {"type": "string", "pattern": "^opaque:[A-Za-z0-9_-]+$"}, "missing_action": {"type": "string"}, "result_refs": {"$ref": "#/$defs/strings"}, "claim_refs": {"$ref": "#/$defs/strings"}, "manuscript_block_refs": {"$ref": "#/$defs/strings"}, "visual_obligation_refs": {"$ref": "#/$defs/strings"}, "manuscript_role": {"enum": ["main", "supplement", "notes_only", "removed"]},
    "design_review": {"type": "object", "required": ["reader_task", "takeaway_sentence", "claim_or_decision", "encoding_choice", "scale_and_denominator", "uncertainty_or_distribution", "annotation_caption", "color_accessibility", "runops_handoff", "acceptance_criteria"], "properties": {"reader_task": {"enum": ["unchecked", "checked"]}, "takeaway_sentence": {"enum": ["unchecked", "checked"]}, "claim_or_decision": {"enum": ["unchecked", "checked"]}, "encoding_choice": {"enum": ["unchecked", "checked"]}, "scale_and_denominator": {"enum": ["unchecked", "checked"]}, "uncertainty_or_distribution": {"enum": ["unchecked", "checked"]}, "annotation_caption": {"enum": ["unchecked", "checked"]}, "color_accessibility": {"enum": ["unchecked", "checked"]}, "runops_handoff": {"enum": ["unchecked", "checked", "not_applicable"]}, "acceptance_criteria": {"enum": ["unchecked", "checked"]}}, "additionalProperties": false},
    "audit_checks": {"type": "object", "required": ["color_range", "decision_boundary_visible", "manuscript_reference", "current_manuscript_role_aligned", "axes", "denominator", "caption_scope", "path_criterion", "state_visualization", "evidence_design"], "properties": {"color_range": {"enum": ["unchecked", "checked", "not_applicable"]}, "decision_boundary_visible": {"enum": ["unchecked", "checked", "not_applicable"]}, "manuscript_reference": {"enum": ["unchecked", "checked", "not_applicable"]}, "current_manuscript_role_aligned": {"enum": ["unchecked", "checked"]}, "axes": {"enum": ["unchecked", "checked"]}, "denominator": {"enum": ["unchecked", "checked"]}, "caption_scope": {"enum": ["unchecked", "checked"]}, "path_criterion": {"enum": ["unchecked", "checked", "not_applicable"]}, "state_visualization": {"enum": ["unchecked", "checked", "not_applicable"]}, "evidence_design": {"enum": ["unchecked", "checked"]}}, "additionalProperties": false},
    "route": {"enum": ["manuscript", "result_card", "claim_card", "analysis_request", "supplement", "discard"]}
  }, "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_hash"], "properties": {"target_id": {"type": "string"}, "relation": {"type": "string"}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]*$"}, "decision": {"enum": ["approved", "rejected", "revoked", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false}
  }
}
