{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperops.local/schemas/research-result.schema.json", "title": "PaperOps Research result", "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "observation", "estimand", "unit_of_analysis", "denominator", "independence_risk", "comparison", "metrics", "quantity_contracts", "source_refs", "artifact_provenance_ids", "workflow_id", "input_manifest_id", "commit_id", "claim_refs", "claim_role", "figure_refs", "manuscript_block_refs", "scope", "limitation", "route"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "result"}, "id": {"type": "string", "pattern": "^RES-[0-9]{4,}$"}, "revision": {"type": "integer"},
    "status": {"enum": ["draft", "observed", "validated", "rejected", "superseded"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "extensions": {"type": "object", "additionalProperties": true}, "metadata": {"$ref": "#/$defs/metadata"},
    "observation": {"type": "string", "minLength": 1}, "estimand": {"type": "string", "minLength": 1}, "unit_of_analysis": {"type": "string", "minLength": 1}, "denominator": {"type": "string", "minLength": 1}, "independence_risk": {"type": "string"},
    "comparison": {"type": "object", "required": ["treatment", "comparator", "metric", "direction_magnitude"], "properties": {"treatment": {"type": "string"}, "comparator": {"type": "string"}, "metric": {"type": "string"}, "direction_magnitude": {"type": "string"}}, "additionalProperties": false},
    "metrics": {"$ref": "#/$defs/strings"}, "quantity_contracts": {"type": "array", "items": {"$ref": "#/$defs/quantity"}}, "source_refs": {"$ref": "#/$defs/strings"}, "artifact_provenance_ids": {"$ref": "#/$defs/strings"}, "workflow_id": {"type": "string", "pattern": "^workflow:[A-Za-z0-9_-]+$"}, "input_manifest_id": {"type": "string", "pattern": "^artifact:[A-Za-z0-9_-]+$"}, "commit_id": {"type": "string", "pattern": "^commit:[A-Fa-f0-9]+$"}, "claim_refs": {"$ref": "#/$defs/strings"}, "claim_role": {"enum": ["core_evidence", "mechanism", "boundary", "robustness", "negative_control", "exploratory"]}, "figure_refs": {"$ref": "#/$defs/strings"}, "manuscript_block_refs": {"$ref": "#/$defs/strings"},
    "scope": {"type": "string", "minLength": 1}, "limitation": {"type": "string"}, "route": {"enum": ["keep", "split", "merge", "gate", "analysis_request", "defer"]}
  }, "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_hash"], "properties": {"target_id": {"type": "string"}, "relation": {"type": "string"}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"enum": ["scientific_scope", "editorial_choice", "submission", "authorship", "license", "external_share", "reviewer_response", "scope_expansion", "waiver"]}, "decision": {"enum": ["approved", "rejected", "revoked", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false},
    "quantity": {"type": "object", "required": ["id", "value", "denominator", "unit", "unit_of_analysis", "estimand", "aggregation", "independence", "source_artifact_id", "manuscript_block_refs"], "properties": {"id": {"type": "string", "pattern": "^QTY-[0-9]{4,}$"}, "value": {"type": "string", "minLength": 1}, "denominator": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "unit_of_analysis": {"type": "string", "minLength": 1}, "estimand": {"type": "string", "minLength": 1}, "aggregation": {"type": "string", "minLength": 1}, "independence": {"type": "string", "minLength": 1}, "source_artifact_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}, "manuscript_block_refs": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}
  }
}
