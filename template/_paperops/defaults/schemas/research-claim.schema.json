{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperops.local/schemas/research-claim.schema.json",
  "title": "PaperOps Research claim",
  "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "statement", "scope", "limitation", "not_claiming", "result_refs", "source_refs", "figure_refs", "manuscript_block_refs", "visual_obligation_refs", "no_figure_reason", "warrant", "assumptions", "gate_id", "gate_status", "human_approval", "abstract_conclusion_allowed", "validation_history", "upstream_feedback_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "claim"},
    "id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"},
    "revision": {"type": "integer"},
    "status": {"enum": ["draft", "proposed", "validated", "approved", "rejected", "superseded"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "extensions": {"type": "object", "additionalProperties": true},
    "metadata": {"$ref": "#/$defs/metadata"},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "limitation": {"type": "string"},
    "not_claiming": {"$ref": "#/$defs/strings"},
    "result_refs": {"$ref": "#/$defs/strings"},
    "source_refs": {"$ref": "#/$defs/strings"},
    "figure_refs": {"$ref": "#/$defs/strings"},
    "manuscript_block_refs": {"$ref": "#/$defs/strings"},
    "visual_obligation_refs": {"$ref": "#/$defs/strings"},
    "no_figure_reason": {"type": "string"},
    "warrant": {"type": "string", "minLength": 1},
    "assumptions": {"$ref": "#/$defs/strings"},
    "gate_id": {"type": "string", "pattern": "^GATE-[0-9]{4,}$"},
    "gate_status": {"enum": ["draft", "ready_to_write", "analysis_needed", "assumption_blocked", "supplement_only", "deferred"]},
    "human_approval": {"enum": ["needed", "approved", "rejected"]},
    "abstract_conclusion_allowed": {"type": "boolean"},
    "validation_history": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "upstream_feedback_refs": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_revision", "expected_hash"], "properties": {"target_id": {"type": "string", "minLength": 1}, "relation": {"type": "string", "minLength": 1}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"enum": ["scientific_scope", "editorial_choice", "submission", "authorship", "license", "external_share", "reviewer_response", "scope_expansion"]}, "decision": {"enum": ["approved", "rejected", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false},
    "validation": {"type": "object", "required": ["validation_id", "decision", "note"], "properties": {"validation_id": {"type": "string", "pattern": "^VAL-[0-9]{4,}$"}, "decision": {"enum": ["validated", "failed", "superseded"]}, "note": {"type": "string"}}, "additionalProperties": false}
  }
}
