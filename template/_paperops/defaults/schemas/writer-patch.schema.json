{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperops.local/schemas/writer-patch.schema.json",
  "title": "PaperOps generated Writer patch",
  "description": "Provisional version 1 patch contract pending the Writer patch DTO task.",
  "type": "object",
  "required": ["schema_version", "session_id", "compile_id", "changes", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"$ref": "#/$defs/safeId"},
    "compile_id": {"$ref": "#/$defs/safeId"},
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*\\x00)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:\\.|\\.\\.)(?:/|$))(?!.*(?:/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:/$|//)).+$"
    },
    "change": {
      "type": "object",
      "required": [
        "path",
        "block_id",
        "operation",
        "preimage_hash",
        "replacement_hash"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "block_id": {"$ref": "#/$defs/safeId"},
        "operation": {"enum": ["keep", "compress", "move", "merge", "split", "cut", "rewrite", "add"]},
        "preimage_hash": {"$ref": "#/$defs/hash"},
        "replacement_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "pointer", "message", "severity", "identity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "pattern": "^(?:$|/)"},
        "message": {"type": "string"},
        "severity": {"enum": ["error", "warning", "info"]},
        "identity": {
          "anyOf": [
            {"const": ""},
            {"$ref": "#/$defs/relativePath"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
