{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://paperops.local/schemas/manuscript-section.schema.json", "title": "PaperOps Manuscript section", "type": "object",
  "required": ["schema_version", "record_type", "id", "revision", "status", "dependencies", "approvals", "extensions", "metadata", "section_kind", "ordered_block_ids", "contract_refs", "editorial_move_refs", "research_refs", "source_language", "mirror_policy", "compiled_manifest_ref", "dependency_hash", "last_verified_dependency_hash"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "section"}, "id": {"type": "string", "pattern": "^SEC-[0-9]{4,}$"}, "revision": {"type": "integer"},
    "status": {"enum": ["unplanned", "planned", "compiled", "drafted", "verified", "stale"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "extensions": {"type": "object", "additionalProperties": true}, "metadata": {"$ref": "#/$defs/metadata"},
    "section_kind": {"enum": ["abstract", "introduction", "methods", "results", "discussion", "conclusion", "supplement"]}, "ordered_block_ids": {"type": "array", "items": {"type": "string", "pattern": "^BLK-[0-9]{4,}$"}},
    "contract_refs": {"$ref": "#/$defs/strings"}, "editorial_move_refs": {"$ref": "#/$defs/strings"}, "move_bindings": {"type": "array", "items": {"$ref": "#/$defs/moveBinding"}}, "research_refs": {"$ref": "#/$defs/strings"},
    "source_language": {"enum": ["ja", "en"]}, "mirror_policy": {"enum": ["paired", "ja_primary", "en_primary", "independent"]}, "compiled_manifest_ref": {"$ref": "#/$defs/manifestOrEmpty"},
    "dependency_hash": {"$ref": "#/$defs/hashOrEmpty"}, "last_verified_dependency_hash": {"$ref": "#/$defs/hashOrEmpty"}
  }, "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "hashOrEmpty": {"anyOf": [{"const": ""}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}, "manifestOrEmpty": {"anyOf": [{"const": ""}, {"type": "string", "pattern": "^manifest:[A-Za-z0-9._-]+$"}]},
    "metadata": {"type": "object", "required": ["updated_at"], "properties": {"updated_at": {"type": "string"}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["target_id", "relation", "expected_hash"], "properties": {"target_id": {"type": "string"}, "relation": {"type": "string"}, "expected_revision": {"type": "integer"}, "expected_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "approval": {"type": "object", "required": ["approval_id", "kind", "decision", "object_revision", "object_hash", "actor", "note"], "properties": {"approval_id": {"type": "string", "pattern": "^APR-[0-9]{4,}$"}, "kind": {"enum": ["scientific_scope", "editorial_choice", "submission", "authorship", "license", "external_share", "reviewer_response", "scope_expansion"]}, "decision": {"enum": ["approved", "rejected", "superseded"]}, "object_revision": {"type": "integer"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "actor": {"const": "human"}, "note": {"type": "string"}}, "additionalProperties": false},
    "moveBinding": {"type": "object", "required": ["move_id", "role", "reason"], "properties": {"move_id": {"type": "string", "pattern": "^MOV-[0-9]{4,}$"}, "role": {"enum": ["primary", "echo"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
