{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperops.local/schemas/writer-packet.schema.json",
  "title": "PaperOps generated Writer packet",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "compile_id",
    "authority",
    "write_scope",
    "inputs",
    "read_context",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"$ref": "#/$defs/safeId"},
    "compile_id": {"$ref": "#/$defs/safeId"},
    "authority": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
    "write_scope": {"$ref": "#/$defs/writeScope"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "read_context": {"$ref": "#/$defs/readContext"},
    "payload": {"$ref": "#/$defs/writerPayload"}
  },
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*\\x00)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:\\.|\\.\\.)(?:/|$))(?!.*(?:/)(?:\\.|\\.\\.)(?:/|$))(?!.*//).+$"
    },
    "strings": {
      "type": "array",
      "items": {"$ref": "#/$defs/safeId"}
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["model", "mode", "hash", "transaction_id"],
      "properties": {
        "model": {"$ref": "#/$defs/safeId"},
        "mode": {"$ref": "#/$defs/safeId"},
        "hash": {"$ref": "#/$defs/hash"},
        "transaction_id": {
          "anyOf": [
            {"const": ""},
            {"$ref": "#/$defs/safeId"}
          ]
        }
      },
      "additionalProperties": false
    },
    "writeScope": {
      "type": "object",
      "required": [
        "level",
        "languages",
        "files",
        "section_ids",
        "block_ids",
        "allowed_operations"
      ],
      "properties": {
        "level": {"enum": ["block", "section", "manuscript"]},
        "languages": {"$ref": "#/$defs/strings"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
        "section_ids": {"$ref": "#/$defs/strings"},
        "block_ids": {"$ref": "#/$defs/strings"},
        "allowed_operations": {
          "type": "array",
          "items": {"enum": ["keep", "compress", "move", "merge", "split", "cut", "rewrite", "add"]}
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["kind", "identity", "type", "hash", "relation"],
      "properties": {
        "kind": {"enum": ["catalog", "content"]},
        "identity": {"$ref": "#/$defs/relativePath"},
        "type": {"$ref": "#/$defs/safeId"},
        "hash": {"$ref": "#/$defs/hash"},
        "relation": {"$ref": "#/$defs/safeId"},
        "model": {"$ref": "#/$defs/safeId"},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "readContext": {
      "type": "object",
      "required": ["schema_version", "global", "extensions"],
      "properties": {
        "schema_version": {"const": 1},
        "global": {"$ref": "#/$defs/relativePath"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "writerPayload": {
      "type": "object",
      "required": ["schema_version", "section_plan", "extensions"],
      "properties": {
        "schema_version": {"const": 1},
        "section_plan": {"$ref": "#/$defs/safeId"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
